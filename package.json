{
  "name": "@catwithoutear/dsh-prompt-assist",
  "version": "1.2.0",
  "description": "Next user prompt previews after completed answers, with Up/Down prompt history.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catwithoutear/dsh-prompt-assist.git"
  },
  "homepage": "https://github.com/catwithoutear/dsh-prompt-assist#readme",
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.2 <0.3.0" },
  "exports": {
    ".": "./src/index.js", "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"
  },
  "files": ["src", "lib/client.js", "build.mjs", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README_ZH.md", "CHANGELOG.md", "LICENSE"],
  "scripts": { "build": "node build.mjs", "test": "node --import ./test/runtime-loader.mjs --test test/*.test.js", "check": "node --check src/index.js && node --check lib/client.js" },
  "dependencies": { "zod": "4.4.3" },
  "peerDependencies": { "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web", "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-locale", "@deepseek-ai/dsh-api-remotes"]
    }
  }
}
