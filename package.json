{
  "name": "@catwithoutear/dsh-prompt-assist",
  "version": "1.3.1",
  "description": "Next prompt previews and continue-after-draft suggestions with Up/Down history, configurable auxiliary model, shortcuts and /clarify optimization.",
  "type": "module",
  "license": "MIT",
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/catwithoutear/dsh-prompt-assist.git"
  },
  "homepage": "https://github.com/catwithoutear/dsh-prompt-assist#readme",
  "engines": { "node": ">=22", "dsh": ">=0.2.1-rc.3 <0.3.0" },
  "exports": {
    ".": "./src/index.js", "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json", "./icon": "./icon.svg"
  },
  "files": ["src", "lib/client.js", "build.mjs", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "README_ZH.md", "CHANGELOG.md", "LICENSE"],
  "scripts": { "build": "node build.mjs", "test": "node --import ./test/runtime-loader.mjs --test test/*.test.js", "check": "node --check src/index.js && node --check lib/client.js", "prepack": "npm run build && npm run check && npm test" },
  "dependencies": { "zod": "4.4.3", "@deepseek-ai/dsh-typert-protocol": "^0.2.1-rc.3" },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": { "@deepseek-ai/schemastery": "^3.18.0" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web", "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  }
}
